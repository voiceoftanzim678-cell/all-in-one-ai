rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is an authenticated administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // AI Tools collection
    match /ai_tools/{toolId} {
      // Public visitors can only read active tools; Admin can read all
      allow read: if resource.data.active == true || isAdmin();
      // Only authenticated admin can create, update, or delete tools
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      // Public visitors can read active categories; Admin can read all
      allow read: if resource.data.active == true || isAdmin();
      // Only authenticated admin can modify categories
      allow create, update, delete: if isAdmin();
    }

    // Site settings collection
    match /settings/{settingId} {
      // Public visitors can read public settings
      allow read: if true;
      // Only authenticated admin can update settings
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      // Users can read own profile; Admin can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Only Admin can grant admin roles or mutate user documents
      allow write: if isAdmin();
    }
  }
}
